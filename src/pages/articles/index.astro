---
import Base from '../../layouts/Base.astro';
import data from '../../../data/articles.json';
import { fmtDate, listedArticles, articleHref } from '../../lib/format.js';

const articles = listedArticles(data.articles);
---
<Base title="Articles · Joseph Bakarji" page="articles" css={['pages']}>
  <Fragment slot="head">
    <script is:inline>
      // Old links were /articles/?slug=x; send them to /articles/x/.
      (function () {
        var s = new URLSearchParams(location.search).get('slug');
        if (s && /^[\w-]+$/.test(s)) location.replace('/articles/' + s + '/' + location.hash);
      })();
    </script>
  </Fragment>
  <div class="page-body">
    <h2 class="page-title">articles</h2>
    <div id="article-list">
      {articles.map(a => {
        const href = articleHref(a);
        const ext = !!a.external_url;
        return (
          <a class="article-card" href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
            <div class="article-title" set:html={a.title + (ext ? ' ↗' : '')} />
            <div class="article-meta">{fmtDate(a.date)}{a.has_math ? ' · math' : ''}</div>
            <div class="article-excerpt" set:html={a.excerpt || ''} />
            <div class="article-tags">
              {(a.tags || []).map(t => <span class="article-tag">{t}</span>)}
              {a.source === 'substack' && <span class="article-tag" style="color:var(--accent-yellow);border-color:rgba(229,192,123,0.3)">substack</span>}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>
