---
import Base from '../../layouts/Base.astro';
import data from '../../../data/articles.json';
import { fmtDate } from '../../lib/format.js';
import { renderMarkdown, splitTitle } from '../../lib/markdown.js';
import 'katex/dist/katex.min.css';

// One page per local article. Drafts (`published: false`) get no page at
// all; unlisted ones (`listed: false`) get a page but stay out of listings.
export function getStaticPaths() {
  const files = import.meta.glob('../../../content/articles/*.md', { query: '?raw', import: 'default', eager: true });
  const bySlug = Object.fromEntries(
    Object.entries(files).map(([path, md]) => [path.split('/').pop().replace(/\.md$/, ''), md])
  );
  const meta = Object.fromEntries((data.articles || []).map(a => [a.slug, a]));
  return Object.keys(bySlug)
    .filter(slug => meta[slug]?.published !== false)
    .map(slug => ({ params: { slug }, props: { md: bySlug[slug], meta: meta[slug] || null } }));
}

const { md, meta } = Astro.props;
const { title: mdTitle, body } = splitTitle(md);
const title = meta?.title || mdTitle || Astro.params.slug;
const html = renderMarkdown(body);
---
<Base
  title={`${title} · Joseph Bakarji`}
  description={meta?.excerpt?.replace(/<[^>]+>/g, '')}
  page="articles"
  css={['pages']}
>
  <div class="page-body">
    <a class="back-link" href="/articles/">articles</a>
    <div class="article-header">
      <h1 set:html={title} />
      {meta && <div class="meta">{fmtDate(meta.date)}{meta.tags?.length ? ' · ' + meta.tags.join(' · ') : ''}</div>}
    </div>
    <div class="article-content" set:html={html} />
  </div>
</Base>
