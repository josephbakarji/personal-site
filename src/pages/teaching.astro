---
import Base from '../layouts/Base.astro';
---
<Base title="Teaching · Joseph Bakarji" page="teaching" css={["pages"]}>
  <div class="page-body">
    <h2 class="page-title">teaching</h2>

    <div class="project-grid">

      <a class="project-card" href="https://ml4science.com" target="_blank" rel="noopener" style="text-decoration:none;">
        <h3>Machine Learning for Science &amp; Engineering</h3>
        <p>Data-driven methods across physical, social, and biological sciences. Sparse regression, neural networks, dynamical systems, and equation discovery.</p>
        <div class="project-tags article-tags">
          <span class="article-tag">AUB</span>
          <span class="article-tag">2022-2023</span>
          <span class="article-tag" style="color:var(--accent-green)">ml4science.com ↗</span>
        </div>
      </a>

      <a class="project-card" href="https://intro2ml.com" target="_blank" rel="noopener" style="text-decoration:none;">
        <h3>Introduction to Machine Learning</h3>
        <p>Supervised and unsupervised learning, linear and logistic regression, PCA, clustering, and deep learning fundamentals.</p>
        <div class="project-tags article-tags">
          <span class="article-tag">AUB</span>
          <span class="article-tag">Fall 2024</span>
          <span class="article-tag" style="color:var(--accent-green)">intro2ml.com ↗</span>
        </div>
      </a>

      <div class="project-card">
        <h3>Dynamics</h3>
        <p>Kinematics and kinetics of particles and rigid bodies. Newton's laws, energy methods, impulse and momentum, and applications to mechanical systems.</p>
        <div class="project-tags article-tags">
          <span class="article-tag">AUB</span>
          <span class="article-tag">Spring 2025</span>
        </div>
      </div>

      <a class="project-card" href="https://databookuw.com/page-5/page-24/" target="_blank" rel="noopener" style="text-decoration:none;">
        <h3>Deep Learning for Fluid Dynamics</h3>
        <p>Surrogate modeling, closure modeling, equation discovery, and physics-informed neural networks applied to fluid systems.</p>
        <div class="project-tags article-tags">
          <span class="article-tag">U. Washington</span>
          <span class="article-tag">Spring 2021</span>
          <span class="article-tag" style="color:var(--accent-green)">course page</span>
        </div>
      </a>

      <div class="project-card">
        <h3>Multiphase Flow in Porous Media</h3>
        <p>Fluid flow in porous media: immiscible and miscible flows, Richards equation, Buckingham-Leverett equation, and applications to subsurface hydrology.</p>
        <div class="project-tags article-tags">
          <span class="article-tag">AUB</span>
          <span class="article-tag">Summer 2018</span>
        </div>
      </div>

    </div>
  </div>
</Base>
